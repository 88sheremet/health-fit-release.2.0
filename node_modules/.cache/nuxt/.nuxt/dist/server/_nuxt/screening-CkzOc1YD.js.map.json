=\"info-icon green\">\r\n            <span class=\"material-icons\">schedule</span>\r\n          </div>\r\n          <div class=\"info-content\">\r\n            <div class=\"info-title\">~2 минуты</div>\r\n            <div class=\"info-text\">Быстрый анализ состояния</div>\r\n          </div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"info-icon blue\">\r\n            <span class=\"material-icons\">monitoring</span>\r\n          </div>\r\n          <div class=\"info-content\">\r\n            <div class=\"info-title\">Персональный результат</div>\r\n            <div class=\"info-text\">Узнай свои основные точки роста</div>\r\n          </div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"info-icon orange\">\r\n            <span class=\"material-icons\">task_alt</span>\r\n          </div>\r\n          <div class=\"info-content\">\r\n            <div class=\"info-title\">Ежедневные задания</div>\r\n            <div class=\"info-text\">Система подстроится под тебя</div>\r\n          </div>\r\n        </div>\r\n      </q-card>\r\n\r\n      <div class=\"bottom-section\">\r\n        <div class=\"hint-text\">\r\n          Твой путь начинается с понимания текущего состояния\r\n        </div>\r\n        <q-btn\r\n          unelevated\r\n          no-caps\r\n          class=\"start-btn\"\r\n          label=\"Начать скрининг\"\r\n          @click=\"startQuestions\"\r\n        />\r\n        <q-btn\r\n          flat\r\n          no-caps\r\n          text-color=\"primary\"\r\n          class=\"skip-btn\"\r\n          label=\"Пропустить\"\r\n          @click=\"skip\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { useScreeningStore } from \"~/stores/screening\";\r\nimport { routes } from \"~/router/routes\";\r\n\r\nconst store = useScreeningStore();\r\n\r\nconst skip = () => {\r\n  store.completeScreening();\r\n  navigateTo(routes.recovery.menu);\r\n};\r\n\r\nconst startQuestions = () => {\r\n  navigateTo(routes.onboarding.questions);\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.screening-page {\r\n  min-height: 100vh;\r\n  padding: 24px;\r\n  background: var(--bg-gradient-main);\r\n}\r\n.screening-container {\r\n  max-width: 430px;\r\n  margin: 0 auto;\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.top-section {\r\n  padding-top: 48px;\r\n  text-align: center;\r\n}\r\n.hero-icon {\r\n  position: relative;\r\n  width: 120px;\r\n  height: 120px;\r\n  margin: 0 auto 28px;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: var(--hero-icon);\r\n  backdrop-filter: blur(12px);\r\n}\r\n.glow {\r\n  position: absolute;\r\n  width: 90px;\r\n  height: 90px;\r\n  border-radius: 50%;\r\n  background: var(--glow-green);\r\n  filter: blur(24px);\r\n  animation: pulse 3s infinite;\r\n}\r\n.main-icon {\r\n  position: relative;\r\n  z-index: 2;\r\n  font-size: 54px;\r\n  color: var(--green);\r\n}\r\n.title {\r\n  font-size: 34px;\r\n  font-weight: 700;\r\n  line-height: 1.15;\r\n  color: var(--black1);\r\n  margin-bottom: 16px;\r\n}\r\n.subtitle {\r\n  font-size: 18px;\r\n  line-height: 1.6;\r\n  color: var(--grey2);\r\n}\r\n.info-card {\r\n  margin-top: 42px;\r\n  padding: 26px 22px;\r\n  border-radius: 28px;\r\n  background: var(--hero-icon);\r\n  backdrop-filter: blur(16px);\r\n  box-shadow: 0 10px 40px var(--shadow-lg);\r\n}\r\n.info-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n  &:not(:last-child) {\r\n    margin-bottom: 28px;\r\n  }\r\n}\r\n.info-icon {\r\n  width: 52px;\r\n  height: 52px;\r\n  border-radius: 16px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 24px;\r\n  flex-shrink: 0;\r\n}\r\n.green {\r\n  background: var(--icon-green-bg);\r\n  color: var(--green);\r\n}\r\n.blue {\r\n  background: var(--icon-blue-bg);\r\n  colo